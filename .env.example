# Copiá este archivo a .env y completá con tus datos reales:
#   cp .env.example .env
#
# Luego generá secrets.h antes de compilar/subir:
#   python3 scripts/generate_secrets.py

WIFI_SSID=TU_RED_WIFI
WIFI_PASSWORD=TU_PASSWORD_WIFI

# HiveMQ Cloud: Access Management -> Credentials (usuario y password generados)
# Cluster Details -> URL del broker (sin mqtts:// ni https://)
# Si la password tiene #, = o espacios, usá comillas:
# MQTT_PASSWORD="mi-clave#con=simbolos"

MQTT_BROKER=TU_CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=TU_USUARIO_HIVEMQ
MQTT_PASSWORD=TU_PASSWORD_HIVEMQ
MQTT_CLIENT_ID=basic-weather-station-esp32
